# ============================================ #
# Queue Display App - Example Configuration
# ============================================ #
# Copy this file to `.env` and edit your values:
#   cp .env.example .env
# Then edit .env with your clinic's URL and settings.

# The public-view page to scrape the queue from
PAGE_URL=http://192.168.1.2:9096/public-view-classic-transactional-multi/YOUR_KEY/YOUR_KEY2

# Local video file (must exist inside public/)
VIDEO_FILE=video.mp4

# Layout dimensions (CSS values)
VIDEO_WIDTH=45vw
BOARD_WIDTH=55vw

# Video appearance
VIDEO_BG_COLOR=#000
VIDEO_FIT=contain

# How often to re-sample the queue page (seconds)
REFRESH_SECS=5

# Playwright Chromium headless mode (set to "0" to see the browser)
PLAYWRIGHT_HEADLESS=1

# Server port
PORT=5001
